# AI APIs - Choose one and add your key
# Google Gemini (Recommended - Free tier available)
VITE_GEMINI_KEY=your_gemini_api_key_here

# OpenAI API (Has free $5 trial)
VITE_OPENAI_KEY=your_openai_api_key_here

# Hugging Face (Free inference)
VITE_HF_TOKEN=your_huggingface_token_here

# Backend API (If using your own server)
VITE_API_BASE_URL=http://localhost:3001

# Optional: Analytics tracking
VITE_ANALYTICS_ID=

# Optional: Custom branding
VITE_APP_NAME=SocialAI Agent
VITE_APP_URL=https://your-domain.com

# Note: 
# 1. Copy this to .env.local
# 2. Never commit .env.local to git
# 3. Add .env.local to .gitignore (already done)